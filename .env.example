# .env.example
WWISER_PY=/absolute/path/to/wwiser.py         # e.g. /opt/bg3/wwiser/wwiser.py
VGMSTREAM_DIR=${WORKSPACE_ROOT}/bg3/vgmstream     # folder containing vgmstream-cli
UNPACKED_DATA=/absolute/path/to/unpacked_data # assets from Lars’ tools
AUDIO_CONVERTED=${WORKSPACE_ROOT}/bg3/sounds/converted   # where WAVs should land
SIDS_WIKI=/absolute/path/to/bg3-sids.wiki     # clone of mapping repo
