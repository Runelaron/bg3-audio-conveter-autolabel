# Paths for pipeline stages. Use absolute paths.
WWISER_PY=/abs/path/to/wwiser/wwiser.py
VGMSTREAM_DIR=/abs/path/to/vgmstream
UNPACKED_DATA=/abs/path/to/BG3-Modders-Multitool/UnpackedData
AUDIO_CONVERTED=/abs/path/to/output/converted
# Optional; defaults to AUDIO_CONVERTED/labeled when unset.
AUDIO_LABELED=/abs/path/to/output/labeled
# Required only when BG3_SORT_BY_SID is enabled.
SIDS_WIKI=/abs/path/to/bg3-sids.wiki

# Optional: auto | alive | basic
PROGRESS_BAR_MODE=auto

# Optional: 1 fails the run when known label coverage gaps remain.
BG3_LABEL_STRICT=0

# Optional: consolidated JSON report written after SID labeling.
BG3_LABEL_REPORT=/abs/path/to/output/label-report.json
