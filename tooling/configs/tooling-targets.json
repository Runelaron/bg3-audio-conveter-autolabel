    "verify-security": {
      "kind": "commands",
      "steps": [
        {
          "name": "gitleaks",
          "required": true,
          "category": "secret-scan",
          "evidence_categories": [
            "secrets"
          ],
          "gate": "required",
          "command": "gitleaks detect --no-git --no-banner --redact --max-target-megabytes 10 --report-format json --report-path \"{artifact_root}/gitleaks.json\" --config tooling/configs/gitleaks/gitleaks.toml --source .",
          "tool": "gitleaks"
        },
        {
          "name": "trivy-fs",
          "required": true,
          "category": "security-scan",
          "evidence_categories": [
            "sca",
            "secrets",
            "iac_misconfig",
            "license"
          ],
          "gate": "required",
          "command": "trivy fs --exit-code 1 --severity HIGH,CRITICAL --ignore-unfixed --scanners vuln,secret,misconfig,license --skip-dirs artifacts --skip-dirs archive --skip-dirs _archive --skip-dirs .data --skip-dirs outputs --skip-dirs packs --skip-dirs node_modules --skip-dirs .venv --skip-dirs .pytest_cache --skip-dirs .ruff_cache --skip-dirs .mypy_cache --skip-dirs .nox --skip-dirs .tox --skip-dirs .uv-cache --skip-dirs dist --skip-dirs build --skip-dirs coverage .",
          "tool": "trivy"
        },
        {
          "name": "workflow-actionlint",
          "required": true,
          "category": "workflow",
          "evidence_categories": [
            "workflow_policy"
          ],
          "gate": "required",
          "command": "if compgen -G \".github/workflows/tooling-*.yml\" > /dev/null; then actionlint .github/workflows/tooling-*.yml; elif compgen -G \".github/workflows/*.yml\" > /dev/null; then actionlint .github/workflows/*.yml; else echo \"no workflows detected\"; fi",
          "tool": "actionlint"
        },
        {
          "name": "workflow-zizmor",
          "required": true,
          "category": "workflow",
          "evidence_categories": [
            "workflow_policy"
          ],
          "gate": "required",
          "command": "if compgen -G \".github/workflows/tooling-*.yml\" > /dev/null; then zizmor .github/workflows/tooling-*.yml; elif compgen -G \".github/workflows/*.yml\" > /dev/null; then zizmor .github/workflows/*.yml; else echo \"no workflows detected\"; fi",
          "tool": "zizmor"
        },
        {
          "name": "workflow-conftest",
          "required": true,
          "category": "workflow",
          "evidence_categories": [
            "workflow_policy"
          ],
          "gate": "required",
          "command": "if compgen -G \".github/workflows/tooling-*.yml\" > /dev/null; then conftest test --all-namespaces -p tooling/policies/conftest/github-actions .github/workflows/tooling-*.yml; elif compgen -G \".github/workflows/*.yml\" > /dev/null; then conftest test --all-namespaces -p tooling/policies/conftest/github-actions .github/workflows/*.yml; else echo \"no workflows detected\"; fi",
          "tool": "conftest"
        },
        {
          "name": "workflow-yamllint",
          "required": true,
          "category": "workflow",
          "evidence_categories": [
            "workflow_policy"
          ],
          "gate": "required",
          "command": "if compgen -G \".github/workflows/tooling-*.yml\" > /dev/null; then yamllint -c tooling/configs/yamllint/yamllint.yaml .github/workflows/tooling-*.yml; elif compgen -G \".github/workflows/*.yml\" > /dev/null; then yamllint -c tooling/configs/yamllint/yamllint.yaml .github/workflows/*.yml; else echo \"no workflows detected\"; fi",
          "tool": "yamllint"
        },
        {
          "name": "semgrep",
          "required": false,
          "category": "security-scan",
          "evidence_categories": [
            "sast"
          ],
          "gate": "advisory",
          "command": "semgrep scan --config auto --error --exclude artifacts --exclude archive --exclude _archive --exclude .data --exclude outputs --exclude packs --exclude node_modules --exclude .venv --exclude .pytest_cache --exclude .ruff_cache --exclude .mypy_cache --exclude .nox --exclude .tox --exclude build --exclude dist --exclude coverage .",
          "tool": "semgrep"
        },
        {
          "name": "pip-audit",
          "required": false,
          "category": "dependency-scan",
          "evidence_categories": [
            "sca"
          ],
          "gate": "advisory",
          "command": "if [ -f pyproject.toml ]; then uv export --format requirements-txt --no-hashes > \"{artifact_root}/python-requirements.txt\" && pip-audit -r \"{artifact_root}/python-requirements.txt\" --no-deps --disable-pip; else echo \"python dependency audit not applicable\"; fi",
          "tool": "pip-audit"
        }
      ],
